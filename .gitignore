# The build output of the dashboard. dist/.keep stays, so that go:embed finds the
# folder before the first build. Each build empties dist and copies public/.keep
# back into it.
/web/node_modules/
/web/dist/*
!/web/dist/.keep

# The binary and the data of a local run.
/deneb
/data/

# The browser test and its screenshots.
/test/browser/node_modules/
/test/browser/screenshots/
